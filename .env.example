# ==============================================================================
# MedEra SaaS Platform - Global Environment Configuration Template
# Copy this file to .env before starting the stack: cp .env.example .env
# NEVER commit .env to version control.
# ==============================================================================

# ── Django Core Settings ──────────────────────────────────────────────────────
SECRET_KEY=generate-a-secure-50-character-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend,web,frontend,host.docker.internal
INTERNAL_API_SECRET=change-this-internal-secret-token-min-32-chars
BOT_API_TOKEN=change-this-bot-api-token-min-32-chars

# ── PostgreSQL Database ───────────────────────────────────────────────────────
POSTGRES_DB=medera
POSTGRES_USER=medera_user
POSTGRES_PASSWORD=change-to-a-strong-database-password
DATABASE_URL=postgresql://medera_user:change-to-a-strong-database-password@db:5432/medera

# ── Redis & Background Workers ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# ── AI Diagnostic Microservice (Flask) ────────────────────────────────────────
AI_INTERNAL_TOKEN=change-this-internal-ai-service-token
AI_SERVICE_URL=http://ai_service:5000
AI_SERVICE_TIMEOUT=30
MODEL_PATH=models/clinical_rf_v1.pkl
FLASK_ENV=production

# ── WhatsApp AI Concierge (FastAPI) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
BACKUP_TWILIO_ACCOUNT_SID=
BACKUP_TWILIO_AUTH_TOKEN=
GROQ_API_KEY=gsk_your_groq_api_key_for_whisper_and_llm
OPENROUTER_API_KEY=sk-or-v1-optional-backup-llm-key
LLM_MODEL=llama-3.1-8b-instant

# ── Email Service (Development: MailHog) ──────────────────────────────────────
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=notifications@medera.ma

# ── Frontend Configuration (React 19 / Vite) ──────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_AI_SERVICE_URL=http://localhost:5000
REACT_APP_AI_TOKEN=change-this-internal-ai-service-token
