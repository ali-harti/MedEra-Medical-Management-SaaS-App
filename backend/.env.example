# MedEra Backend — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env — only .env.example is committed

# Django
SECRET_KEY=your-django-secret-key-minimum-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://medera_user:medera_password@localhost:5432/medera_db

# AI Service connection
AI_SERVICE_URL=http://localhost:5000
AI_INTERNAL_TOKEN=your-internal-token-here
AI_SERVICE_TIMEOUT=10

# Email (Mailhog for development)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
